# Copiá este archivo a .env y completá tus claves: cp .env.example .env

# --- API keys (al menos la del proveedor que uses) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Proveedor: openai | anthropic ---
LLM_PROVIDER=openai

# --- Modelos (opcionales; si se omiten se usan los defaults del código) ---
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Parámetros del modelo (opcionales, validados con Pydantic) ---
# temperature: 0 a 2 (sólo la aplica OpenAI; Anthropic la ignora). 0 = más predecible.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
# Timeout por request, en segundos
LLM_TIMEOUT=60
# Reintentos extra ante JSON mal formado/incompleto o errores transitorios (2 → hasta 3 intentos)
LLM_MAX_RETRIES=2
